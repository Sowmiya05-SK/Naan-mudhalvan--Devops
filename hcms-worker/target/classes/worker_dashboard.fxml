<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.hcmsworker.controller.WorkerController"
      spacing="10"
      alignment="TOP_CENTER">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Worker Dashboard" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="complaintsTable" prefHeight="300" prefWidth="700">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colName" text="Name" prefWidth="120"/>
            <TableColumn fx:id="colRoom" text="Room" prefWidth="80"/>
            <TableColumn fx:id="colCategory" text="Category" prefWidth="120"/>
            <TableColumn fx:id="colDesc" text="Description" prefWidth="200"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="80"/>
        </columns>
    </TableView>

    <HBox spacing="8">
        <Label text="New Status:"/>
        <ComboBox fx:id="statusCombo"/>
        <Button text="Update Status" onAction="#handleUpdateStatus"/>
    </HBox>

    <TextArea fx:id="remarksArea" promptText="Add remarks..." prefRowCount="3"/>
    <Button text="Add Remarks &amp; Notify" onAction="#handleAddRemarks"/>

</VBox>