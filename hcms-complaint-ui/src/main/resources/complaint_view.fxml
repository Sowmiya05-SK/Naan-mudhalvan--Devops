<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.hcms.controller.ComplaintController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>
  <Label text="Hostel Complaint Form" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
  <GridPane hgap="10" vgap="10">
    <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Label text="Room No:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="roomField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    <Label text="Category:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <ComboBox fx:id="categoryCombo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    <Label text="Description:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <TextArea fx:id="descArea" prefRowCount="4" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
  </GridPane>

  <HBox spacing="10" alignment="CENTER">
    <Button text="Submit Complaint" onAction="#handleSubmit"/>
    <Button text="Refresh List" onAction="#handleRefresh"/>
  </HBox>

  <Label text="My Complaints" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
  <TableView fx:id="complaintsTable" prefHeight="200" prefWidth="600">
    <columns>
      <TableColumn text="ID" fx:id="colId" prefWidth="60"/>
      <TableColumn text="Category" fx:id="colCategory" prefWidth="120"/>
      <TableColumn text="Room" fx:id="colRoom" prefWidth="80"/>
      <TableColumn text="Status" fx:id="colStatus" prefWidth="100"/>
      <TableColumn text="Description" fx:id="colDesc" prefWidth="240"/>
    </columns>
  </TableView>
</VBox>
